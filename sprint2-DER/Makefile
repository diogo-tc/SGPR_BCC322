all: Makefile sgpr_gui

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/x86_64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents src/gui/mainwindow.h $(DISTDIR)/
	$(COPY_FILE) --parents src/gui/main.cpp src/gui/mainwindow.cpp src/lib/domain/Despesa.cpp src/lib/domain/EqualRateio.cpp src/lib/domain/Extrato.cpp src/lib/domain/Rateio.cpp src/lib/domain/Usuario.cpp src/lib/services/ServicoDespesas.cpp src/lib/services/ServicoExtrato.cpp src/lib/services/ServicoRateio.cpp src/lib/infra/factory/Factory.cpp src/lib/infra/repository/InMemoryDespesaRepository.cpp src/lib/infra/persistence/SQLiteDespesaRepository.cpp $(DISTDIR)/
	$(COPY_FILE) --parents mainwindow.ui src/gui/mainwindow.ui $(DISTDIR)/


